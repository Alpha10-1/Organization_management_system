+    resp = admin_client.post("/invoices/", json={"project_id": project_id, "contract_id": contract_id})
+    assert resp.status_code == 200, resp.text
+    return resp.json()
+
+
+def test_send_invoice_transitions_draft_to_sent(admin_client):

From b764592553e78c7c2a8770250b8674f25d7329be Mon Sep 17 00:00:00 2001
From: Alpha10-1 <92021278+Alpha10-1@users.noreply.github.com>
Date: Sun, 16 Aug 2026 06:39:44 +0000
Subject: [PATCH] test: give admin_client/staff_client independent cookie jars

admin_client and staff_client previously both wrapped the same
'client' fixture instance, so a test requesting both fixtures at once
would silently lose the first login (last login wins on the shared
cookie jar). Each fixture now logs in on its own TestClient, so a
single test can safely act as two different logged-in users.

- Removed the ad-hoc _second_client() workaround in test_time_entries.py
  in favor of using staff_client directly now that it's independent.
- Added a regression test (test_admin_and_staff_clients_stay_independent)
  asserting both sessions stay valid and correctly scoped when used
  together in the same test.
---
 backend/tests/conftest.py          | 36 ++++++++++++++++++------------
 backend/tests/test_auth.py         | 22 ++++++++++++++++++
 backend/tests/test_time_entries.py | 28 +++++------------------
 3 files changed, 50 insertions(+), 36 deletions(-)

diff --git a/backend/tests/conftest.py b/backend/tests/conftest.py
index 571e847..52eefc1 100644
--- a/backend/tests/conftest.py
+++ b/backend/tests/conftest.py
@@ -42,21 +42,29 @@ def client():
         yield c
 
 
+def _login(email: str, password: str):
+    """Log in on a brand-new TestClient with its own cookie jar. Each
+    fixture that needs an authenticated user gets an independent client
+    here rather than sharing one -- previously admin_client and
+    staff_client both logged in on the same underlying `client` fixture
+    instance, so requesting both in one test silently left only the
+    second login's cookie (auth bleed-through). Independent jars mean a
+    single test can safely act as two different logged-in users at once.
+    """
+    with TestClient(app) as c:
+        resp = c.post(
+            "/auth/login",
+            data={"username": email, "password": password},
+        )
+        assert resp.status_code == 200, resp.text
+        yield c
+
+
 @pytest.fixture
-def admin_client(client):
-    resp = client.post(
-        "/auth/login",
-        data={"username": ADMIN_EMAIL, "password": ADMIN_PASSWORD},
-    )
-    assert resp.status_code == 200, resp.text
-    return client
+def admin_client():
+    yield from _login(ADMIN_EMAIL, ADMIN_PASSWORD)
 
 
 @pytest.fixture
-def staff_client(client):
-    resp = client.post(
-        "/auth/login",
-        data={"username": STAFF_EMAIL, "password": STAFF_PASSWORD},
-    )
-    assert resp.status_code == 200, resp.text
-    return client
+def staff_client():
+    yield from _login(STAFF_EMAIL, STAFF_PASSWORD)

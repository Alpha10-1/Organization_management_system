+# Local S3-compatible storage for dev, via MinIO.
+#
+# This is opt-in: the backend defaults to STORAGE_BACKEND=local (plain
+# disk, no Docker needed). Bring this up when you want to develop/test
+# against the S3 code path without touching a real AWS bucket.
+#
+# Usage:
+#   docker compose up -d
+#   -> MinIO API:      http://localhost:9000
+#   -> MinIO Console:  http://localhost:9001  (login: minioadmin / minioadmin)
+#
+# The `createbuckets` service runs once, creates the bucket the backend
+# expects (oms-uploads), and exits -- `docker compose up` will show it as
+# exited(0), that's expected, not a failure.
+#
+# Then in backend/.env:
+#   STORAGE_BACKEND=s3
+#   S3_BUCKET=oms-uploads
+#   S3_ENDPOINT_URL=http://localhost:9000
+#   S3_REGION=us-east-1
+#   AWS_ACCESS_KEY_ID=minioadmin
+#   AWS_SECRET_ACCESS_KEY=minioadmin
+#
+# To reset (wipe all uploaded files in the dev bucket):
+#   docker compose down -v
+
+services:
+  minio:
+    image: minio/minio:latest
+    container_name: oms-minio
+    command: server /data --console-address ":9001"
+    ports:
+      - "9000:9000"   # S3 API
+      - "9001:9001"   # Web console
+    environment:
+      MINIO_ROOT_USER: minioadmin
+      MINIO_ROOT_PASSWORD: minioadmin
+    volumes:
+      - minio-data:/data
+    healthcheck:
+      test: ["CMD", "curl", "-f", "http://localhost:9000/minio/health/live"]
+      interval: 5s
+      timeout: 5s
+      retries: 5
+
+  createbuckets:
+    image: minio/mc:latest
+    container_name: oms-minio-createbuckets
+    depends_on:
+      minio:
+        condition: service_healthy
+    entrypoint: >
+      /bin/sh -c "
+      mc alias set local http://minio:9000 minioadmin minioadmin &&
+      mc mb -p local/oms-uploads &&
+      echo 'Bucket oms-uploads ready.'
+      "
+
+volumes:
+  minio-data:

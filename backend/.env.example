# Copy this file to .env and fill in real values. .env is gitignored.

# Required. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# "development" (default) allows the app to boot without SECRET_KEY set,
# generating a temporary one each run (all sessions invalidated on restart).
# "production" makes a missing/placeholder SECRET_KEY a hard startup error.
ENVIRONMENT=development

# Optional. Max upload size in MB (default: 25)
MAX_UPLOAD_SIZE_MB=25

# Optional. Comma-separated list of origins allowed to call this API.
# Defaults to http://localhost:3000,http://127.0.0.1:3000 if unset.
# NOTE: this list controls which origins CORS allows -- it does NOT fix a
# hostname mismatch between frontend and backend. The browser treats
# localhost and 127.0.0.1 as different sites for cookie purposes, so if you
# open the frontend at localhost:3000, run this backend reachable at
# localhost:8000 too (see frontend/.env.example), not 127.0.0.1:8000, or
# the login cookie won't come back on later requests.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional. Set to true once served over HTTPS so the auth cookie is
# marked Secure. Automatically true when ENVIRONMENT=production.
COOKIE_SECURE=false

# Optional. Absolute path to store uploaded files. Defaults to
# backend/uploads if unset. Only used when STORAGE_BACKEND=local (default).
UPLOAD_DIR=

# Optional. File storage backend: "local" (default) or "s3".
# "s3" works against real AWS S3 as well as any S3-compatible endpoint
# (MinIO, Cloudflare R2, etc) -- set S3_ENDPOINT_URL for anything that
# isn't AWS. Credentials are picked up the normal boto3 way (env vars
# AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY, a shared config file, or an
# instance/task role) -- nothing else to configure here.
#
# To develop against a local MinIO instance instead of local disk:
#   1. From the repo root: docker compose up -d
#   2. Uncomment the six lines below
STORAGE_BACKEND=local

# Required when STORAGE_BACKEND=s3. Target bucket name.
S3_BUCKET=

# Optional. Only needed for non-AWS S3-compatible endpoints, e.g.
# http://localhost:9000 for a local MinIO instance.
S3_ENDPOINT_URL=

# Optional. AWS region (ignored by most non-AWS endpoints).
S3_REGION=

# Optional. Key prefix within the bucket, e.g. "prod" or "uploads".
S3_PREFIX=

# --- Local MinIO quickstart (uncomment to use, after `docker compose up -d`) ---
# STORAGE_BACKEND=s3
# S3_BUCKET=oms-uploads
# S3_ENDPOINT_URL=http://localhost:9000
# S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin

# Optional. E-signature backend: "mock" (default) or "docusign".
# "mock" makes no external calls -- envelopes are created in-process and
# stay "sent" until something completes them via POST /esign/webhook
# (a real provider's callback, or your own test/dev tooling).
ESIGN_BACKEND=mock

# Required if ESIGN_BACKEND=docusign. Point BASE_URL at the developer
# sandbox (https://demo.docusign.net/restapi) or production
# (https://na1.docusign.net/restapi depending on your account's base URI).
# NOTE: not exercised against a real DocuSign account in this codebase's
# dev/test environment -- smoke-test against your sandbox before relying
# on it. See app/core/esign.py.
DOCUSIGN_ACCESS_TOKEN=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_BASE_URL=

# Shared secret the e-sign provider's webhook must present (header
# X-Esign-Webhook-Secret) to mark an envelope completed/declined/voided.
# Defaults to an insecure dev value if unset -- set a real one before
# exposing /esign/webhook publicly.
ESIGN_WEBHOOK_SECRET=


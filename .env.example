# URL of the backend API. Must use the SAME HOSTNAME (localhost vs 127.0.0.1)
# that you use to open this frontend in your browser -- browsers treat those
# as different sites, and the login cookie (SameSite=Lax) will silently fail
# to come back on later requests if they don't match. If you open the
# frontend at http://localhost:3000, keep this as http://localhost:8000.
# If you instead use http://127.0.0.1:3000, change this to
# http://127.0.0.1:8000 and start the backend with the matching CORS_ORIGINS
# entry (see backend/.env.example).
NEXT_PUBLIC_API_URL=http://localhost:8000
